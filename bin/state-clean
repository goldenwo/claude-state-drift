#!/usr/bin/env python3
"""state-clean — keep .claude/state.json lean by archiving stale `done` deliverables
out to an append-only .claude/state-archive.jsonl.

state.json is meant to hold CURRENT state; the work record grows without bound as
`done` deliverables accumulate (they are never rendered by where-am-i, so they are
pure disk weight). This tool moves old `done` entries into a companion archive,
losslessly: the archive is append-only, and git/CHANGELOG/state-history are the
backstop. Only `done` deliverables are eligible — in-progress / deferred / blocked,
open_questions, and the current_focus head are NEVER touched.

DEFAULT IS DRY-RUN. Nothing is written without --apply.

Usage:
    state-clean [<root>] [--apply] [--keep N] [--older-than DAYS] [--strip-prior] [--json]

    --apply          write changes (default: dry-run — print what WOULD move)
    --keep N         always keep the N most-recent done deliverables in state.json
                     regardless of age (default 10)
    --older-than D   only archive done deliverables completed more than D days ago
                     (default 30); entries with a missing/unparseable completed_at
                     are NEVER archived (can't be safely dated)
    --strip-prior    also drop '===PRIOR===' tail segments from current_focus
                     (keeps only the head before the first marker)
    --root <path>    project root (default: $CLAUDE_PROJECT_DIR, else cwd)
    --json           machine-readable summary

Exit codes:
    0  ok (dry-run or applied)
    2  usage error (message on stderr, no traceback)
    1  unexpected I/O failure (message on stderr, no traceback)
"""

import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

from _state_lib import parse_iso  # noqa: E402

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
if hasattr(sys.stderr, "reconfigure"):
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

PRIOR_MARKER = "===PRIOR==="
ARCHIVE_FILENAME = "state-archive.jsonl"


def project_root(arg):
    """Resolve the project root — mirrors bin/where-am-i / bin/state-history."""
    if arg:
        return Path(arg).resolve()
    env = os.environ.get("CLAUDE_PROJECT_DIR")
    if env:
        return Path(env).resolve()
    return Path.cwd()


def _take_int(argv, i, flag, lo):
    """Parse `--flag <int>` with a lower bound, or return (None, None) on error."""
    if i + 1 >= len(argv):
        print(f"state-clean: {flag} requires a value", file=sys.stderr)
        return None, None
    try:
        v = int(argv[i + 1])
    except ValueError:
        print(f"state-clean: {flag} must be an integer", file=sys.stderr)
        return None, None
    if v < lo:
        print(f"state-clean: {flag} must be >= {lo}", file=sys.stderr)
        return None, None
    return v, i + 2


def parse_args(argv):
    """Return an opts dict, or None on a usage error (after a stderr message)."""
    opts = {"root": None, "apply": False, "keep": 10, "older_than": 30,
            "strip_prior": False, "json": False, "_positional": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--help", "-h"):
            print(__doc__)
            return {"_help": True}
        elif a == "--apply":
            opts["apply"] = True; i += 1
        elif a == "--strip-prior":
            opts["strip_prior"] = True; i += 1
        elif a == "--json":
            opts["json"] = True; i += 1
        elif a == "--keep":
            opts["keep"], i = _take_int(argv, i, "--keep", 0)
            if opts["keep"] is None:
                return None
        elif a == "--older-than":
            opts["older_than"], i = _take_int(argv, i, "--older-than", 0)
            if opts["older_than"] is None:
                return None
        elif a == "--root":
            if i + 1 >= len(argv):
                print("state-clean: --root requires a value", file=sys.stderr)
                return None
            opts["root"] = argv[i + 1]; i += 2
        elif a.startswith("--"):
            print(f"state-clean: unknown flag: {a}", file=sys.stderr)
            return None
        else:
            opts["_positional"] = a; i += 1
    return opts


def select_archivable(deliverables, keep, older_than, now):
    """Return (archivable, kept_reason) — the list of `done` deliverables eligible
    to archive, given keep-recent-N and the age cutoff. A `done` entry is archivable
    iff it has a parseable completed_at older than the cutoff AND is not among the
    `keep` most-recent done entries. Non-done entries are never selected."""
    done = [d for d in deliverables if d.get("status") == "done"]
    # rank done entries by completed_at (newest first); undateable sort last.
    def _key(d):
        dt = parse_iso(d.get("completed_at"))
        return dt or datetime.min.replace(tzinfo=timezone.utc)
    done_sorted = sorted(done, key=_key, reverse=True)
    protected = set(id(d) for d in done_sorted[:keep])  # keep N most-recent
    cutoff_secs = older_than * 86400
    archivable = []
    for d in done:
        if id(d) in protected:
            continue
        dt = parse_iso(d.get("completed_at"))
        if dt is None:
            continue  # undateable → never archive (can't be safely aged)
        if (now - dt).total_seconds() > cutoff_secs:
            archivable.append(d)
    return archivable


def run_tests():
    """Self-test. state-clean is the only untested bin/ tool that MUTATES
    state.json, which is why it gets a real suite rather than a smoke check.

    The cases that matter most are the ones protecting against silent DATA
    LOSS, because this tool's failure mode is not a crash — it is quietly
    archiving something it should have kept:

      C3  an undateable `completed_at` must never be archived (nothing can
          age it, so archiving it is a guess);
      C6  the keep-N protection must cover the N most-recently-COMPLETED
          entries, not the first N in list order. select_archivable sorts
          before slicing; a regression that dropped the sort would still
          pass C2 (which happens to be ordered) and lose real work here;
      I3  the archive is append-only — a regression that opened it "w"
          instead of "a" destroys every prior archive and would otherwise
          look like a clean run;
      I5  non-`done` deliverables and open_questions are out of scope
          entirely and must survive --apply untouched.
    """
    import contextlib
    import io
    import tempfile

    passed = failed = 0
    cases = []

    def check(name, cond):
        nonlocal passed, failed
        if cond:
            passed += 1
        else:
            failed += 1
            cases.append(f"  FAIL  {name}")

    now = datetime(2026, 8, 5, tzinfo=timezone.utc)

    def d(did, status="done", completed=None):
        e = {"id": did, "status": status}
        if completed is not None:
            e["completed_at"] = completed
        return e

    # --- select_archivable (pure) --------------------------------------
    old, recent = "2026-01-01", "2026-08-04"
    check("C1 non-done statuses are never archivable",
          select_archivable([d("a", "in_progress", old), d("b", "deferred", old),
                             d("c", "blocked", old)], 0, 30, now) == [])
    got = select_archivable([d("old1", completed=old), d("old2", completed=old)], 1, 30, now)
    check("C2 keep-N protects the N most recent", len(got) == 1)
    check("C3 undateable completed_at is never archived",
          select_archivable([d("nodate")], 0, 30, now) == [])
    check("C3b unparseable completed_at is never archived",
          select_archivable([d("bad", completed="not-a-date")], 0, 30, now) == [])
    check("C4 entries younger than the cutoff are kept",
          select_archivable([d("fresh", completed=recent)], 0, 30, now) == [])
    check("C5 keep=0 allows every aged entry",
          len(select_archivable([d("x", completed=old), d("y", completed=old)], 0, 30, now)) == 2)
    # C6 TEETH: newest-first ordering. The oldest entry is FIRST in the list,
    # so a regression slicing list order instead of sorted order protects the
    # wrong one and archives the newest — real work lost.
    ordered = [d("oldest", completed="2026-01-01"), d("newest", completed="2026-06-01")]
    got = select_archivable(ordered, 1, 30, now)
    check("C6 keep-N protects the newest, not the first in list order",
          [e["id"] for e in got] == ["oldest"])

    # --- parse_args ----------------------------------------------------
    check("P1 unknown flag is a usage error", parse_args(["--nope"]) is None)
    check("P2 non-integer --keep is a usage error", parse_args(["--keep", "x"]) is None)
    check("P3 negative --keep is a usage error", parse_args(["--keep", "-1"]) is None)
    check("P4 --older-than 0 is accepted", (parse_args(["--older-than", "0"]) or {}).get("older_than") == 0)
    check("P5 --root without a value is a usage error", parse_args(["--root"]) is None)
    defaults = parse_args([]) or {}
    check("P6 defaults are keep=10 older_than=30 dry-run",
          defaults.get("keep") == 10 and defaults.get("older_than") == 30
          and defaults.get("apply") is False)

    # --- integration (real files, real --apply) -------------------------
    def fixture(tmp, focus="head ===PRIOR=== tail"):
        root = Path(tmp)
        (root / ".claude").mkdir(parents=True, exist_ok=True)
        state = {
            "schema_version": 1, "objective": "o", "version": "9.9.9",
            "current_focus": focus,
            "deliverables": [
                d("aged", completed="2026-01-01"),
                d("keeper", "in_progress"),
                d("deferred-one", "deferred"),
            ],
            "open_questions": [{"q": "still open", "asked_at": "2026-01-01"}],
            "last_updated": "2026-01-01T00:00:00Z",
        }
        (root / ".claude" / "state.json").write_text(
            json.dumps(state, indent=2), encoding="utf-8")
        return root

    def run(root, *flags):
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main(["--root", str(root), "--keep", "0", *flags])
        return rc, buf.getvalue()

    with tempfile.TemporaryDirectory() as tmp:
        root = fixture(tmp)
        sp = root / ".claude" / "state.json"
        before = sp.read_bytes()
        rc, _ = run(root)
        check("I1 dry-run leaves state.json byte-identical",
              rc == 0 and sp.read_bytes() == before)
        check("I1b dry-run creates no archive",
              not (root / ".claude" / ARCHIVE_FILENAME).is_file())

    with tempfile.TemporaryDirectory() as tmp:
        root = fixture(tmp)
        sp, ap = root / ".claude" / "state.json", root / ".claude" / ARCHIVE_FILENAME
        rc, _ = run(root, "--apply")
        st = json.loads(sp.read_text(encoding="utf-8"))
        ids = [x["id"] for x in st["deliverables"]]
        check("I2 --apply removes the archived entry from state.json",
              rc == 0 and "aged" not in ids)
        check("I2b --apply appends it to the archive",
              ap.is_file() and '"aged"' in ap.read_text(encoding="utf-8"))
        rec = json.loads(ap.read_text(encoding="utf-8").splitlines()[0])
        check("I4 archived record carries archived_at", "archived_at" in rec)
        check("I5 non-done deliverables survive --apply",
              "keeper" in ids and "deferred-one" in ids)
        check("I5b open_questions survive --apply",
              st.get("open_questions") and st["open_questions"][0]["q"] == "still open")
        check("I8 no .clean-tmp is left behind",
              not list((root / ".claude").glob("*.clean-tmp")))
        # I3 TEETH: append-only. Re-seed a second archivable entry and apply
        # again; the FIRST archive line must still be there afterwards.
        st["deliverables"].append(d("aged2", completed="2026-01-02"))
        sp.write_text(json.dumps(st, indent=2), encoding="utf-8")
        run(root, "--apply")
        lines = [ln for ln in ap.read_text(encoding="utf-8").splitlines() if ln.strip()]
        check("I3 archive is append-only across runs (prior record survives)",
              len(lines) == 2 and '"aged"' in lines[0] and '"aged2"' in lines[1])

    with tempfile.TemporaryDirectory() as tmp:
        root = fixture(tmp)
        sp = root / ".claude" / "state.json"
        run(root, "--apply")
        check("I6 current_focus untouched without --strip-prior",
              json.loads(sp.read_text(encoding="utf-8"))["current_focus"]
              == "head ===PRIOR=== tail")
    with tempfile.TemporaryDirectory() as tmp:
        root = fixture(tmp)
        sp = root / ".claude" / "state.json"
        run(root, "--apply", "--strip-prior")
        check("I7 --strip-prior keeps only the head before the first marker",
              json.loads(sp.read_text(encoding="utf-8"))["current_focus"] == "head")
    with tempfile.TemporaryDirectory() as tmp:
        root = fixture(tmp, focus="no marker here")
        sp = root / ".claude" / "state.json"
        run(root, "--apply", "--strip-prior")
        check("I7b --strip-prior is a no-op when no marker is present",
              json.loads(sp.read_text(encoding="utf-8"))["current_focus"] == "no marker here")

    with tempfile.TemporaryDirectory() as tmp:
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main(["--root", str(Path(tmp) / "nope")])
        check("I9 missing state.json exits 1", rc == 1)
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        (root / ".claude").mkdir(parents=True)
        (root / ".claude" / "state.json").write_text("{not json", encoding="utf-8")
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main(["--root", str(root)])
        check("I10 malformed state.json exits 1", rc == 1)
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        (root / ".claude").mkdir(parents=True)
        (root / ".claude" / "state.json").write_text("[1,2]", encoding="utf-8")
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main(["--root", str(root)])
        check("I10b non-object state.json exits 1", rc == 1)

    for line in cases:
        print(line)
    print(f"--- state-clean --test: {passed} passed, {failed} failed ---")
    return 1 if failed else 0


def main(argv):
    if argv and argv[0] == "--test":
        return run_tests()
    opts = parse_args(argv)
    if opts is None:
        return 2
    if opts.get("_help"):
        return 0

    root = project_root(opts.get("root") or opts.get("_positional"))
    state_path = root / ".claude" / "state.json"
    if not state_path.is_file():
        print(f"state-clean: no state.json at {state_path}", file=sys.stderr)
        return 1
    try:
        state = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as e:
        print(f"state-clean: cannot read state.json: {e}", file=sys.stderr)
        return 1
    if not isinstance(state, dict):
        print("state-clean: state.json is not a JSON object", file=sys.stderr)
        return 1

    now = datetime.now(timezone.utc)
    deliverables = state.get("deliverables", []) or []
    archivable = select_archivable(deliverables, opts["keep"], opts["older_than"], now)

    cf = state.get("current_focus", "") or ""
    strip = opts["strip_prior"] and PRIOR_MARKER in cf
    new_cf = cf.split(PRIOR_MARKER)[0].rstrip() if strip else cf

    done_total = sum(1 for d in deliverables if d.get("status") == "done")
    summary = {
        "deliverables_total": len(deliverables),
        "done_total": done_total,
        "archivable": len(archivable),
        "kept_done": done_total - len(archivable),
        "strip_prior": strip,
        "current_focus_chars_before": len(cf),
        "current_focus_chars_after": len(new_cf),
        "applied": False,
        "archive_ids": [d.get("id") for d in archivable],
    }

    if opts["apply"] and (archivable or strip):
        arch_path = root / ".claude" / ARCHIVE_FILENAME
        arch_path.parent.mkdir(parents=True, exist_ok=True)
        stamp = now.strftime("%Y-%m-%dT%H:%M:%SZ")
        try:
            with arch_path.open("a", encoding="utf-8") as fh:
                for d in archivable:
                    rec = dict(d)
                    rec["archived_at"] = stamp
                    fh.write(json.dumps(rec, separators=(",", ":"), ensure_ascii=False) + "\n")
            arch_ids = set(id(d) for d in archivable)
            state["deliverables"] = [d for d in deliverables if id(d) not in arch_ids]
            if strip:
                state["current_focus"] = new_cf
            tmp = state_path.with_suffix(".json.clean-tmp")
            tmp.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n",
                           encoding="utf-8")
            os.replace(tmp, state_path)  # atomic swap
        except OSError as e:
            print(f"state-clean: write failed: {e}", file=sys.stderr)
            return 1
        summary["applied"] = True

    if opts["json"]:
        print(json.dumps(summary, indent=2))
        return 0

    mode = "APPLIED" if summary["applied"] else ("DRY-RUN" if (archivable or strip) else "nothing to do")
    print(f"state-clean [{mode}] — {root.name or root}")
    print(f"  done deliverables: {done_total} (keeping {summary['kept_done']}, "
          f"archiving {len(archivable)}; keep>={opts['keep']}, older-than>{opts['older_than']}d)")
    for d in archivable:
        print(f"    archive: {d.get('id')}  (completed {d.get('completed_at')})")
    if strip:
        print(f"  current_focus: strip ===PRIOR=== {len(cf)} -> {len(new_cf)} chars")
    if not summary["applied"] and (archivable or strip):
        print("  (dry-run — re-run with --apply to write; archived entries go to "
              ".claude/state-archive.jsonl, reversible)")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
